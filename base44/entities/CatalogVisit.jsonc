{
  "name": "CatalogVisit",
  "type": "object",
  "properties": {
    "licensee_id": {
      "type": "string",
      "description": "ID do licenciado (AppUser)"
    },
    "referral_code": {
      "type": "string",
      "description": "C\u00f3digo de refer\u00eancia do licenciado"
    },
    "page": {
      "type": "string",
      "description": "Caminho/URL acessado"
    },
    "user_agent": {
      "type": "string",
      "description": "User Agent do visitante"
    },
    "session_id": {
      "type": "string",
      "description": "Identificador de sess\u00e3o (opcional)"
    },
    "visited_at": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data/hora da visita"
    }
  },
  "required": [
    "licensee_id"
  ],
  "rls": {
    "read": null,
    "write": null
  }
}