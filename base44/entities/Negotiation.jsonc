{
  "name": "Negotiation",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "seller_id": {
      "type": "string",
      "description": "ID do vendedor que criou a negocia\u00e7\u00e3o"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "table_price": {
            "type": "number"
          },
          "negotiated_price": {
            "type": "number"
          },
          "discount_percent": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "default": [],
      "description": "Lista de produtos na negocia\u00e7\u00e3o"
    },
    "total_value": {
      "type": "number",
      "default": 0,
      "description": "Valor total da negocia\u00e7\u00e3o (soma autom\u00e1tica)"
    },
    "status": {
      "type": "string",
      "enum": [
        "em_andamento",
        "fechada",
        "perdida"
      ],
      "default": "em_andamento",
      "description": "Status da negocia\u00e7\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a negocia\u00e7\u00e3o"
    },
    "closed_date": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data de fechamento/perda"
    },
    "closed_by": {
      "type": "string",
      "description": "Quem fechou a negocia\u00e7\u00e3o"
    }
  },
  "required": [
    "customer_id",
    "seller_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}