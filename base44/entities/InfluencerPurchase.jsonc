{
  "name": "InfluencerPurchase",
  "type": "object",
  "properties": {
    "influencer_id": {
      "type": "string",
      "description": "ID do influenciador que indicou"
    },
    "lead_user_id": {
      "type": "string",
      "description": "ID do lead que comprou"
    },
    "auction_id": {
      "type": "string",
      "description": "ID do leil\u00e3o/produto"
    },
    "product_title": {
      "type": "string",
      "description": "T\u00edtulo do produto"
    },
    "amount": {
      "type": "number",
      "description": "Valor da compra em R$"
    },
    "purchase_date": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data da compra"
    },
    "partner_store": {
      "type": "string",
      "default": "sai_de_baixo",
      "description": "Loja parceira"
    }
  },
  "required": [
    "influencer_id",
    "lead_user_id",
    "auction_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "influencer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": null
  }
}