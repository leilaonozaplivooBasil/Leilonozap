{
  "name": "LoteRecebido",
  "type": "object",
  "properties": {
    "nome_lote": {
      "type": "string",
      "description": "Nome ou identifica\u00e7\u00e3o do lote"
    },
    "marketplace": {
      "type": "string",
      "enum": [
        "Mercado Livre",
        "Shopee",
        "Magazine Luiza",
        "Casas Bahia",
        "Extra",
        "Amazon",
        "Americanas",
        "Submarino",
        "Netshoes",
        "Dafiti",
        "OLX",
        "Outros"
      ],
      "description": "Marketplace de origem do lote"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo enviado (planilha, PDF, Word, XML)"
    },
    "arquivo_nome": {
      "type": "string",
      "description": "Nome original do arquivo"
    },
    "arquivo_tipo": {
      "type": "string",
      "description": "Tipo/extens\u00e3o do arquivo"
    },
    "status": {
      "type": "string",
      "enum": [
        "recebido",
        "em_analise",
        "comprado",
        "convertido",
        "enviado_ao_estoque",
        "cancelado"
      ],
      "default": "recebido",
      "description": "Status do lote"
    },
    "valor_lote": {
      "type": "number",
      "default": 0,
      "description": "Valor do lote (custo total)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o lote"
    },
    "data_recebimento": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data de recebimento do lote"
    },
    "itens_json": {
      "type": "string",
      "description": "JSON serializado com itens agrupados do lote ([{desc, qtd, valor_mercado, grade}])"
    },
    "quantidade_total": {
      "type": "number",
      "default": 0,
      "description": "Quantidade total de itens do lote"
    },
    "valor_mercado_total": {
      "type": "number",
      "default": 0,
      "description": "Valor de mercado total do lote"
    },
    "valor_arremate": {
      "type": "number",
      "default": 0,
      "description": "Valor pago no arremate do lote"
    },
    "custo_total": {
      "type": "number",
      "default": 0,
      "description": "Custo total do lote (arremate + taxa + frete + outros)"
    },
    "taxa_pct": {
      "type": "number",
      "default": 0,
      "description": "Percentual da taxa do marketplace/leil\u00e3o (ex: 7 para 7%)"
    },
    "frete": {
      "type": "number",
      "default": 0,
      "description": "Custo de frete do lote"
    },
    "outros": {
      "type": "number",
      "default": 0,
      "description": "Outros custos adicionais do lote"
    },
    "local_coleta": {
      "type": "string",
      "description": "Local de coleta/carregamento do lote"
    },
    "origem": {
      "type": "string",
      "description": "Origem do lote (Mercado Livre, Casa e V\u00eddeo, etc)"
    },
    "categorias_json": {
      "type": "string",
      "description": "JSON com resumo de categorias do lote"
    },
    "grades_json": {
      "type": "string",
      "description": "JSON com a distribui\u00e7\u00e3o de grades A/B/C/D/E/U do lote"
    },
    "produtos_gerados": {
      "type": "boolean",
      "default": false,
      "description": "Indica se os produtos j\u00e1 foram gerados no estoque (evita duplica\u00e7\u00e3o)"
    },
    "produtos_gerados_em": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data/hora em que os produtos foram gerados no estoque"
    },
    "produtos_gerados_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de registros Product criados a partir deste lote"
    },
    "deposito_destino": {
      "type": "string",
      "enum": [
        "Bangu",
        "Oficina",
        "Recreio"
      ],
      "default": "Bangu",
      "description": "Dep\u00f3sito onde os produtos ser\u00e3o alocados"
    }
  },
  "required": [
    "nome_lote",
    "marketplace"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}