{
  "name": "WithdrawalRequest",
  "type": "object",
  "properties": {
    "influencer_id": {
      "type": "string",
      "description": "ID do influenciador"
    },
    "amount": {
      "type": "number",
      "description": "Valor solicitado para saque"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Status do saque"
    },
    "pix_key": {
      "type": "string",
      "description": "Chave PIX"
    },
    "pix_key_type": {
      "type": "string",
      "enum": [
        "CPF",
        "CNPJ",
        "EMAIL",
        "PHONE",
        "RANDOM"
      ],
      "description": "Tipo da chave PIX"
    },
    "recipient_name": {
      "type": "string",
      "description": "Nome do titular"
    },
    "recipient_document": {
      "type": "string",
      "description": "CPF/CNPJ do titular"
    },
    "processed_by": {
      "type": "string",
      "description": "ID do admin que processou"
    },
    "processed_date": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data do processamento"
    },
    "transaction_id": {
      "type": "string",
      "description": "ID da transa\u00e7\u00e3o banc\u00e1ria"
    },
    "notes": {
      "type": "string",
      "description": "Notas/observa\u00e7\u00f5es"
    }
  },
  "required": [
    "influencer_id",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "influencer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}