{
  "name": "TaxSettings",
  "type": "object",
  "properties": {
    "icms_rate": {
      "type": "number",
      "default": 18,
      "description": "Al\u00edquota ICMS em % (ex: 18 para 18%)"
    },
    "pis_rate": {
      "type": "number",
      "default": 0.65,
      "description": "Al\u00edquota PIS em %"
    },
    "cofins_rate": {
      "type": "number",
      "default": 3,
      "description": "Al\u00edquota COFINS em %"
    },
    "irpj_rate": {
      "type": "number",
      "default": 8,
      "description": "Al\u00edquota IRPJ em % (sobre presun\u00e7\u00e3o de lucro)"
    },
    "csll_rate": {
      "type": "number",
      "default": 2.88,
      "description": "Al\u00edquota CSLL em % (sobre presun\u00e7\u00e3o de lucro)"
    },
    "iss_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota ISS em % (apenas para servi\u00e7os)"
    },
    "profit_presumption_rate": {
      "type": "number",
      "default": 32,
      "description": "% de presun\u00e7\u00e3o de lucro para c\u00e1lculo IRPJ/CSLL"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o c\u00e1lculo est\u00e1 ativo"
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}