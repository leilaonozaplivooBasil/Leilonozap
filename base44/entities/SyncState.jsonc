{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "sync_token": {
      "type": "string",
      "description": "Token para sincroniza\u00e7\u00e3o incremental com Google Calendar"
    },
    "last_sync": {
      "type": "string",
      "format": "datetime-local",
      "description": "Timestamp da \u00faltima sincroniza\u00e7\u00e3o"
    }
  },
  "required": [
    "sync_token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}