{
  "name": "OAuthToken",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Nome do provedor OAuth (olx, mercadolivre, etc)"
    },
    "code": {
      "type": "string",
      "description": "Authorization code recebido"
    },
    "access_token": {
      "type": "string",
      "description": "Access token obtido"
    },
    "refresh_token": {
      "type": "string",
      "description": "Refresh token obtido"
    },
    "expires_at": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data de expira\u00e7\u00e3o do token"
    },
    "state": {
      "type": "string",
      "description": "State parameter para valida\u00e7\u00e3o"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que autorizou"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired",
        "revoked"
      ],
      "default": "pending",
      "description": "Status do token"
    }
  },
  "required": [
    "provider",
    "code"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}