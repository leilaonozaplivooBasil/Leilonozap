{
  "name": "MercadoPagoPayment",
  "type": "object",
  "properties": {
    "auction_id": {
      "type": "string",
      "description": "ID do leil\u00e3o relacionado (opcional para compras de cat\u00e1logo)"
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto do cat\u00e1logo (opcional para leil\u00f5es)"
    },
    "catalog_sale_id": {
      "type": "string",
      "description": "ID da venda no cat\u00e1logo (se aplic\u00e1vel)"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio comprador"
    },
    "preference_id": {
      "type": "string",
      "description": "ID da prefer\u00eancia criada no Mercado Pago"
    },
    "payment_id": {
      "type": "string",
      "description": "ID do pagamento confirmado"
    },
    "amount": {
      "type": "number",
      "description": "Valor do pagamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled",
        "refunded"
      ],
      "default": "pending",
      "description": "Status do pagamento"
    },
    "payment_method": {
      "type": "string",
      "description": "M\u00e9todo de pagamento (pix, credit_card, etc)"
    },
    "external_reference": {
      "type": "string",
      "description": "Refer\u00eancia externa (auction_id ou product_id + timestamp)"
    },
    "buyer_address": {
      "type": "string",
      "description": "Endere\u00e7o completo do comprador"
    }
  },
  "required": [
    "user_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}