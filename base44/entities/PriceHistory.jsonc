{
  "name": "PriceHistory",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID do produto que teve o pre\u00e7o alterado"
    },
    "product_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto (cache para exibi\u00e7\u00e3o)"
    },
    "old_price": {
      "type": "number",
      "description": "Pre\u00e7o de venda anterior"
    },
    "new_price": {
      "type": "number",
      "description": "Novo pre\u00e7o de venda aplicado"
    },
    "old_market": {
      "type": "number",
      "description": "Valor de mercado anterior"
    },
    "new_market": {
      "type": "number",
      "description": "Novo valor de mercado encontrado"
    },
    "variation_percent": {
      "type": "number",
      "description": "Varia\u00e7\u00e3o percentual do pre\u00e7o (pode ser negativa)"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "auto_traffic",
        "manual_single",
        "manual_batch",
        "scheduled"
      ],
      "default": "auto_traffic",
      "description": "Tipo de gatilho que disparou a atualiza\u00e7\u00e3o"
    },
    "sessions_active": {
      "type": "number",
      "description": "Quantidade de sess\u00f5es ativas no momento da atualiza\u00e7\u00e3o (para modo auto_traffic)"
    },
    "floor_applied": {
      "type": "boolean",
      "default": false,
      "description": "Se o piso de seguran\u00e7a (custo x 1.3) foi aplicado em vez do pre\u00e7o de mercado"
    },
    "source_url": {
      "type": "string",
      "description": "URL do produto usado como refer\u00eancia (Mercado Livre / Google Shopping)"
    }
  },
  "required": [
    "product_id",
    "new_price"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": null
  }
}