{
  "name": "BalanceTransfer",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "ID de quem enviou o saldo"
    },
    "sender_name": {
      "type": "string",
      "description": "Nome de quem enviou (cache)"
    },
    "receiver_id": {
      "type": "string",
      "description": "ID de quem recebeu o saldo"
    },
    "receiver_name": {
      "type": "string",
      "description": "Nome de quem recebeu (cache)"
    },
    "amount": {
      "type": "number",
      "description": "Valor transferido em R$"
    },
    "note": {
      "type": "string",
      "description": "Nota/observa\u00e7\u00e3o opcional da transfer\u00eancia"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Status da transfer\u00eancia"
    }
  },
  "required": [
    "sender_id",
    "receiver_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.receiver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}