{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/c/:cargo", "destination": "/api/convite?cargo=:cargo" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
