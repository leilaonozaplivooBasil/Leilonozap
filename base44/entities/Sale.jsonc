{
  "name": "Sale",
  "type": "object",
  "properties": {
    "order_code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do pedido (ex: PED-20250101-123456)"
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto vendido"
    },
    "product_description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "product_lot": {
      "type": "string",
      "description": "Lote/SKU do produto"
    },
    "quantity_sold": {
      "type": "number",
      "description": "Quantidade vendida nesta transa\u00e7\u00e3o"
    },
    "unit_price": {
      "type": "number",
      "description": "Pre\u00e7o unit\u00e1rio na venda"
    },
    "total_amount": {
      "type": "number",
      "description": "Valor total da transa\u00e7\u00e3o (bruto)"
    },
    "total_taxes": {
      "type": "number",
      "default": 0,
      "description": "Total de impostos sobre a venda"
    },
    "net_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor l\u00edquido (total - impostos - comiss\u00e3o)"
    },
    "product_cost": {
      "type": "number",
      "default": 0,
      "description": "Custo unit\u00e1rio do produto no momento da venda (cost_price da entidade Product)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "PIX",
        "DINHEIRO",
        "CART\u00c3O D\u00c9BITO",
        "CART\u00c3O CR\u00c9DITO",
        "BOLETO PARCELADO"
      ],
      "description": "Forma de pagamento"
    },
    "receiving_bank": {
      "type": "string",
      "enum": [
        "santander",
        "itau",
        "nubank"
      ],
      "default": "santander",
      "description": "Banco que recebeu o valor: santander (Produtos F\u00edsicos), itau (Licenciados), nubank (Parceiros)"
    },
    "sale_date": {
      "type": "string",
      "format": "date",
      "description": "Data da venda"
    },
    "sale_datetime": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data e hora exata da venda"
    },
    "operator_name": {
      "type": "string",
      "description": "Nome do operador que fez a venda"
    },
    "seller_id": {
      "type": "string",
      "description": "ID do vendedor que realizou a venda"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "commission_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "description": "Tipo de comiss\u00e3o: porcentagem ou valor fixo"
    },
    "commission_value": {
      "type": "number",
      "default": 0,
      "description": "Valor da comiss\u00e3o (% ou R$)"
    },
    "commission_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor final calculado da comiss\u00e3o"
    },
    "boleto_cliente": {
      "type": "string",
      "description": "Nome do cliente (para boleto)"
    },
    "boleto_documento": {
      "type": "string",
      "description": "Documento do cliente (para boleto)"
    },
    "boleto_parcelas": {
      "type": "number",
      "description": "N\u00famero de parcelas (para boleto)"
    }
  },
  "required": [
    "product_id",
    "quantity_sold",
    "total_amount",
    "payment_method",
    "sale_date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}