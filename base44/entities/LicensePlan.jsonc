{
  "name": "LicensePlan",
  "type": "object",
  "properties": {
    "plan_code": {
      "type": "string",
      "enum": [
        "kit_catalogo",
        "kit_start",
        "plano_lider",
        "plano_lojista",
        "plano_distribuidor"
      ],
      "description": "C\u00f3digo \u00fanico do plano"
    },
    "plan_name": {
      "type": "string",
      "description": "Nome do plano"
    },
    "commission_rate": {
      "type": "number",
      "description": "Taxa de comiss\u00e3o (0.13 a 0.20)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do plano"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de benef\u00edcios"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o para adquirir o plano"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se o plano est\u00e1 ativo"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "plan_code",
    "plan_name",
    "commission_rate",
    "price"
  ],
  "rls": {
    "read": null,
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}