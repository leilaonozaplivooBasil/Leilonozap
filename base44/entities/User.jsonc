{
  "name": "User",
  "type": "object",
  "properties": {
    "password": {
      "type": "string",
      "description": "Senha do usu\u00e1rio"
    },
    "phone": {
      "type": "string",
      "description": "N\u00famero do telefone/WhatsApp"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Pontos de gamifica\u00e7\u00e3o"
    },
    "total_bids": {
      "type": "number",
      "default": 0,
      "description": "Total de lances dados"
    },
    "won_auctions": {
      "type": "number",
      "default": 0,
      "description": "Leil\u00f5es vencidos"
    },
    "avatar_color": {
      "type": "string",
      "default": "#25D366",
      "description": "Cor do avatar do usu\u00e1rio"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL do avatar personalizado"
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o usu\u00e1rio aceitou os termos e condi\u00e7\u00f5es."
    }
  },
  "rls": {
    "read": null,
    "write": null
  },
  "required": [
    "phone"
  ]
}