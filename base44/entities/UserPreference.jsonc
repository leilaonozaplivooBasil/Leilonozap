{
  "name": "UserPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio"
    },
    "preferred_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categorias de interesse"
    },
    "price_range_min": {
      "type": "number",
      "description": "Faixa de pre\u00e7o m\u00ednima"
    },
    "price_range_max": {
      "type": "number",
      "description": "Faixa de pre\u00e7o m\u00e1xima"
    },
    "preferred_source": {
      "type": "string",
      "enum": [
        "all",
        "factory_new",
        "return_resale"
      ],
      "default": "all",
      "description": "Prefer\u00eancia de origem do produto"
    },
    "parceiro_demo_inicio": {
      "type": "string",
      "format": "datetime-local",
      "description": "\u00c2ncora do MODO DEMONSTRA\u00c7\u00c3O da Linha do Tempo do Parceiro: data em que a demonstra\u00e7\u00e3o passou a contar (simula o dia do aporte). Fica na conta para o dia do ciclo ser o mesmo no celular, no computador e no app. N\u00e3o \u00e9 aporte real, n\u00e3o gera valor devido."
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}