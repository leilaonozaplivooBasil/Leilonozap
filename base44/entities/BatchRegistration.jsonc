{
  "name": "BatchRegistration",
  "type": "object",
  "properties": {
    "numero_leilao": {
      "type": "string",
      "description": "N\u00famero do leil\u00e3o (do cabe\u00e7alho da nota fiscal)"
    },
    "nome_origem": {
      "type": "string",
      "description": "Nome da origem/fornecedor (ex: Alcance Leil\u00f5es, Mercado Livre, etc)"
    },
    "lotes": {
      "type": "array",
      "description": "Lista de lotes dentro do leil\u00e3o",
      "items": {
        "type": "object",
        "properties": {
          "numero_lote": {
            "type": "string",
            "description": "N\u00famero do lote (ex: 15575, 15615)"
          },
          "produtos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "codigo": {
                  "type": "string",
                  "description": "C\u00f3digo interno do produto (ex: 001)"
                },
                "descricao": {
                  "type": "string",
                  "description": "Descri\u00e7\u00e3o do produto"
                },
                "variacao": {
                  "type": "string",
                  "description": "Varia\u00e7\u00e3o do produto (ex: 2L, 5L, cor, tamanho)"
                },
                "quantidade": {
                  "type": "number",
                  "description": "Quantidade desse produto no lote"
                }
              }
            }
          },
          "valor_lote": {
            "type": "number",
            "description": "Valor total do lote"
          }
        }
      }
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total da nota fiscal"
    },
    "total_produtos": {
      "type": "number",
      "description": "Quantidade total de produtos em TODOS os lotes"
    },
    "custo_por_unidade": {
      "type": "number",
      "description": "Valor total \u00f7 total de produtos (global)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "convertido"
      ],
      "default": "pendente"
    },
    "recibo_url": {
      "type": "string",
      "description": "URL do arquivo da nota fiscal"
    },
    "data_lancamento": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data e hora do lan\u00e7amento/registro da nota"
    }
  },
  "required": [
    "numero_leilao"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}