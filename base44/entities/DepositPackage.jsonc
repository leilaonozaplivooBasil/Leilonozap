{
  "name": "DepositPackage",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Nome do pacote (ex: 'Dep\u00f3sito R$ 100')"
    },
    "amount": {
      "type": "number",
      "description": "Valor do pacote em reais"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o pacote est\u00e1 ativo"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "bonus_percentage": {
      "type": "number",
      "default": 0,
      "description": "Porcentagem de b\u00f4nus (ex: 10 para 10%)"
    }
  },
  "required": [
    "label",
    "amount"
  ],
  "rls": {
    "read": null,
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}