{
  "name": "PaymentSettings",
  "type": "object",
  "properties": {
    "gateway_name": {
      "type": "string",
      "enum": [
        "stripe",
        "mercadopago",
        "pagarme",
        "asaas",
        "manual",
        "generic_http"
      ],
      "description": "Gateway de pagamento"
    },
    "gateway_type": {
      "type": "string",
      "enum": [
        "generic_http",
        "specific"
      ],
      "default": "generic_http",
      "description": "Tipo de integra\u00e7\u00e3o do gateway"
    },
    "base_url": {
      "type": "string",
      "description": "URL base da API do gateway"
    },
    "payment_endpoint": {
      "type": "string",
      "description": "Endpoint para criar cobran\u00e7a (ex: /payments, /charges)"
    },
    "http_method": {
      "type": "string",
      "enum": [
        "POST",
        "PUT",
        "PATCH"
      ],
      "default": "POST",
      "description": "M\u00e9todo HTTP para cria\u00e7\u00e3o de cobran\u00e7a"
    },
    "headers_json": {
      "type": "string",
      "description": "Headers em JSON (ex: {\"Authorization\": \"Bearer {{API_KEY}}\"})"
    },
    "api_key": {
      "type": "string",
      "description": "Chave da API (criptografada)"
    },
    "webhook_secret": {
      "type": "string",
      "description": "Secret para valida\u00e7\u00e3o de webhook"
    },
    "reference_field": {
      "type": "string",
      "default": "reference_id",
      "description": "Nome do campo para enviar reference_id ao gateway"
    },
    "status_field_path": {
      "type": "string",
      "default": "status",
      "description": "Caminho do campo de status no webhook (ex: status, data.status)"
    },
    "approved_status_value": {
      "type": "string",
      "default": "paid",
      "description": "Valor que indica pagamento aprovado (ex: paid, approved, succeeded)"
    },
    "is_active": {
      "type": "boolean",
      "default": false,
      "description": "Gateway ativo"
    },
    "pix_key": {
      "type": "string",
      "description": "Chave PIX para recebimento"
    },
    "pix_key_type": {
      "type": "string",
      "enum": [
        "cpf",
        "cnpj",
        "email",
        "phone",
        "random"
      ],
      "description": "Tipo da chave PIX"
    },
    "bank_account": {
      "type": "string",
      "description": "Conta banc\u00e1ria para recebimento"
    },
    "wallet_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Habilitar carteira interna"
    },
    "wallet_deposit_message": {
      "type": "string",
      "default": "Escolha o valor que deseja adicionar \u00e0 sua conta",
      "description": "Mensagem exibida na tela de dep\u00f3sito"
    },
    "wallet_insufficient_message": {
      "type": "string",
      "default": "Saldo insuficiente. Por favor, adicione saldo para continuar.",
      "description": "Mensagem quando saldo \u00e9 insuficiente"
    },
    "wallet_max_balance": {
      "type": "number",
      "description": "Limite m\u00e1ximo de saldo (opcional)"
    }
  },
  "required": [
    "gateway_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}