{
  "name": "FreteSettings",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Client ID da API dos Correios"
    },
    "client_secret": {
      "type": "string",
      "description": "Client Secret da API dos Correios"
    },
    "cep_origem": {
      "type": "string",
      "description": "CEP de origem para c\u00e1lculo"
    },
    "comprimento_padrao": {
      "type": "number",
      "default": 20,
      "description": "Comprimento padr\u00e3o em cm"
    },
    "altura_padrao": {
      "type": "number",
      "default": 10,
      "description": "Altura padr\u00e3o em cm"
    },
    "largura_padrao": {
      "type": "number",
      "default": 15,
      "description": "Largura padr\u00e3o em cm"
    },
    "peso_padrao": {
      "type": "number",
      "default": 1,
      "description": "Peso padr\u00e3o em kg"
    },
    "servico_pac": {
      "type": "boolean",
      "default": true,
      "description": "Habilitar PAC"
    },
    "servico_sedex": {
      "type": "boolean",
      "default": true,
      "description": "Habilitar SEDEX"
    },
    "token_cache": {
      "type": "string",
      "description": "Token OAuth cacheado"
    },
    "token_expiry": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data de expira\u00e7\u00e3o do token"
    }
  },
  "required": [
    "client_id",
    "client_secret",
    "cep_origem"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}