{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "parent_category_id": {
      "type": "string",
      "description": "ID da categoria pai (null se for categoria principal)"
    },
    "parent_category_name": {
      "type": "string",
      "description": "Nome da categoria pai (cache)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a categoria est\u00e1 ativa"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": null,
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}