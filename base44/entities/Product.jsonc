{
  "name": "Product",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da compra/entrada"
    },
    "lot": {
      "type": "string",
      "description": "N\u00famero do lote"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "URLs das imagens do produto"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Quantidade em estoque"
    },
    "qty_perfeito": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em perfeito estado"
    },
    "qty_bom": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em bom estado"
    },
    "qty_ruim": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em estado ruim"
    },
    "qty_oficina": {
      "type": "number",
      "default": 0,
      "description": "Quantidade na oficina"
    },
    "quantity_sold": {
      "type": "number",
      "default": 0,
      "description": "Quantidade j\u00e1 vendida"
    },
    "cost_price": {
      "type": "number",
      "default": 0,
      "description": "Pre\u00e7o de custo unit\u00e1rio (C.U.L)"
    },
    "selling_price_retail": {
      "type": "number",
      "description": "Pre\u00e7o de venda varejo (P/V)"
    },
    "selling_price_wholesale": {
      "type": "number",
      "description": "Pre\u00e7o de venda licenciado (P/LIC)"
    },
    "price_auction_start": {
      "type": "number",
      "description": "Pre\u00e7o inicial do leil\u00e3o"
    },
    "price_buy_now": {
      "type": "number",
      "description": "Pre\u00e7o 'Arremate Agora'"
    },
    "price_catalog": {
      "type": "number",
      "description": "Pre\u00e7o do Cat\u00e1logo para licenciados"
    },
    "catalog_active": {
      "type": "boolean",
      "default": false,
      "description": "Se o produto est\u00e1 dispon\u00edvel no cat\u00e1logo"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Se o produto est\u00e1 em destaque no cat\u00e1logo"
    },
    "status": {
      "type": "string",
      "enum": [
        "ESTOQUE",
        "VENDIDO PIX",
        "VENDIDO DINHEIRO",
        "CONSERTO",
        "BRINDE VENDEDOR"
      ],
      "default": "ESTOQUE",
      "description": "Status atual"
    },
    "sold_amount": {
      "type": "number",
      "description": "Valor vendido total acumulado"
    },
    "profit": {
      "type": "number",
      "description": "Lucro l\u00edquido acumulado"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "purchase_order": {
      "type": "string",
      "description": "Nota fiscal de compra (0001, 0002, etc)"
    },
    "deposit_name": {
      "type": "string",
      "enum": [
        "Bangu",
        "Oficina",
        "Recreio"
      ],
      "default": "Bangu",
      "description": "Nome do dep\u00f3sito onde o produto est\u00e1 armazenado"
    },
    "peso": {
      "type": "number",
      "description": "Peso do produto em kg (para c\u00e1lculo de frete)"
    },
    "comprimento": {
      "type": "number",
      "description": "Comprimento em cm (para c\u00e1lculo de frete)"
    },
    "altura": {
      "type": "number",
      "description": "Altura em cm (para c\u00e1lculo de frete)"
    },
    "largura": {
      "type": "number",
      "description": "Largura em cm (para c\u00e1lculo de frete)"
    },
    "linked_auctions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs dos leil\u00f5es criados a partir deste produto"
    },
    "pricing_formula_id": {
      "type": "string",
      "description": "ID da f\u00f3rmula de precifica\u00e7\u00e3o vinculada"
    },
    "market_value": {
      "type": "number",
      "description": "Valor de mercado do produto"
    },
    "calculated_price": {
      "type": "number",
      "description": "Pre\u00e7o calculado pela f\u00f3rmula"
    },
    "discount_percentage": {
      "type": "number",
      "description": "% de desconto sobre o valor de mercado"
    },
    "last_dynamic_update": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data/hora da \u00faltima atualiza\u00e7\u00e3o de pre\u00e7o pelo PrecificaVivo (usado para exibir badge Pre\u00e7o Din\u00e2mico)"
    }
  },
  "required": [
    "description"
  ],
  "rls": {
    "read": null,
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}