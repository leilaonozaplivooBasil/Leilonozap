{
  "name": "ComparaiCache",
  "type": "object",
  "properties": {
    "auction_id": {
      "type": "string",
      "description": "ID do leil\u00e3o"
    },
    "mode": {
      "type": "string",
      "enum": [
        "supplier",
        "google_shopping"
      ],
      "description": "Modo de compara\u00e7\u00e3o usado"
    },
    "result": {
      "type": "object",
      "description": "Resultado da compara\u00e7\u00e3o em JSON"
    },
    "expires_at": {
      "type": "string",
      "format": "datetime-local",
      "description": "Data de expira\u00e7\u00e3o do cache"
    }
  },
  "required": [
    "auction_id",
    "mode"
  ],
  "rls": {
    "read": null,
    "write": null
  }
}